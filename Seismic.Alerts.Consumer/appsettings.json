{
  "ConnectionStrings": {
    "NotificationsDb": "Data Source=notifications.db"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "seismic",
    "Password": "seismic"
  },
  "RabbitMqTopology": {
    "ExchangeName": "seismic.alerts",
    "AuditQueue": {
      "Name": "notifications.audit",
      "RoutingKey": "quake.#"
    },
    "SubscribersQueue": {
      "Name": "notifications.subscribers",
      "RoutingKey": "quake.*.*"
    },
    "CriticalQueue": {
      "Name": "notifications.critical",
      "RoutingKey": "quake.*.strong"
    },
    "PrefetchCount": 1,
    "DeadLetterExchange": "seismic.alerts.dlx",
    "DeadLetterQueue": "notifications.dlq"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}