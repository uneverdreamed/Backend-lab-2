{
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "seismic",
    "Password": "seismic"
  },
  "RabbitMqTopology": {
    "ExchangeName": "seismic.alerts"
  },
  "AlertClassification": {
    "StrongThreshold": 6.0,
    "ModerateThreshold": 4.5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}